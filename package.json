{
  "name": "dastkhat",
  "version": "0.4.0",
  "description": "Persian reading & writing helper for Chrome, Edge and Firefox: RTL, Persian fonts, highlights and AI rewrite/translate.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dastyar-io/dastkhat-browser-extension.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:edge": "node scripts/build.mjs edge",
    "build:firefox": "node scripts/build.mjs firefox",
    "fonts": "node scripts/bundle-fonts.mjs",
    "lint:firefox": "npx web-ext lint --source-dir dist/firefox"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/dastyar-io/dastkhat-browser-extension#readme",
  "bugs": {
    "url": "https://github.com/dastyar-io/dastkhat-browser-extension/issues"
  },
  "keywords": [
    "persian",
    "farsi",
    "rtl",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "manifest-v3",
    "ai",
    "translation",
    "highlighter"
  ]
}
